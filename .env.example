# ibl.ai configuration — copy to .env.local (gitignored) and set your values.
# The four URLs below mirror the code defaults in lib/iblai/config.ts (hosted
# iblai.app), so the app works without them — they are listed here as the
# knobs to change when self-hosting. NEXT_PUBLIC_MAIN_TENANT_KEY is required.
# Nothing in this file is a secret: the app holds no platform API key. The
# buyer's own sign-in token and the admin's own sign-in token are the only
# credentials it ever sends; the Platform API Token lives in iblai.env, for
# deploying only.
# Distributed self-hosted mode: delete the NEXT_PUBLIC_API_BASE_URL line
# (and set your own NEXT_PUBLIC_PLATFORM_BASE_DOMAIN) so each service derives
# its own subdomain — editing only the domain keeps you on this single origin.
NEXT_PUBLIC_API_BASE_URL=https://api.iblai.app
NEXT_PUBLIC_AUTH_URL=https://login.iblai.app
NEXT_PUBLIC_BASE_WS_URL=wss://asgi.data.iblai.app
NEXT_PUBLIC_PLATFORM_BASE_DOMAIN=iblai.app
NEXT_PUBLIC_MAIN_TENANT_KEY=your-platform

# The one agent this app fronts: the last path segment of its os.ibl.ai URL,
# https://os.ibl.ai/platform/<platform-key>/<agent-uuid>. And what the login
# screens, the browser tab and the Stripe product call the app: human-readable,
# two or three words in Title Case (Babatunde Tutor), never a slug. The Get
# and run procedure in AGENTS.md writes both.
NEXT_PUBLIC_DEFAULT_AGENT_ID=
NEXT_PUBLIC_APP_NAME=
NEXT_PUBLIC_SUPPORT_EMAIL=

# Paywall (see README "Paywall"). NEXT_PUBLIC_PAYWALL_APP_SLUG names this app
# on the platform: it tags the Stripe product (metadata.app, the platform's
# checkout rule) and keys the paywall choice in the platform's public metadata
# (apps.<slug>), which the in-app setup at /setup writes. The browser sends it
# with every paywall call it makes to the platform; the admin routes read it too.
NEXT_PUBLIC_PAYWALL_APP_SLUG=vibe-agent

# Mobile (Tauri iOS/Android) SSO return scheme. Desktop and web ignore it.
NEXT_PUBLIC_TAURI_CUSTOM_SCHEME=vibe-agent

# Show the About tab and /about (off by default).
NEXT_PUBLIC_SHOW_ABOUT=false
